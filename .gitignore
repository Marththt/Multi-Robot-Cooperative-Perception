# Real scenes with combined rounds (regenerated with python -m pipeline.combine_rounds)
data/real_combined/

# Image datasets (old image networks; YOLO: python -m yolo_gnn.train_seg / yolo_gnn.segment_real)
data/bev*/
data/yolo_sim/
data/yolo_real/

# Files set aside for deletion
_to_delete/

# One run per layout of a campaign (python -m tools.select_runs)
data/survey_v2_best/

# Live demo: states streamed by the robots and working files of the page
data/live/
data/demo_work/

# end-to-end network: rendered sets
data/e2e/
data/e2e_real/
